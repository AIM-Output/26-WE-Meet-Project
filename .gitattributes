# 줄바꿈: 저장소엔 LF, Windows 배치/PowerShell 은 항상 CRLF 로 체크아웃
* text=auto
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
# 셸 스크립트는 어느 OS 에서 받아도 LF (CRLF 면 맥에서 '/bin/bash^M' 로 실행이 안 된다)
*.sh text eol=lf

# 바이너리
*.lnk binary
*.docx binary
*.pdf binary
*.pptx binary
*.db binary
*.png binary
*.ico binary
*.icns binary
*.jpg binary
