# notice_agent 환경변수 — 복사해서 .env 로 (커밋 금지)
#   슬롯 이름은 Univ-Us_AI/.env.example 과 같다. 코드에는 모델명을 쓰지 않는다.
#   비워두면 LLM 단계 없이 규칙 추출만 동작하고, 모든 건이 '확인 필요'로 분류된다.

# ── LLM_MAIN: 자격요건 구조화 추출 + 신청서 초안 (OpenAI 호환 API 면 무엇이든) ──
# 예) Upstage Solar :  LLM_MAIN_BASE_URL=https://api.upstage.ai/v1   LLM_MAIN_MODEL=solar-pro3
# 예) OpenAI        :  LLM_MAIN_BASE_URL=https://api.openai.com/v1   LLM_MAIN_MODEL=gpt-4.1-mini
# 예) 로컬 vLLM     :  LLM_MAIN_BASE_URL=http://localhost:8000/v1    LLM_MAIN_MODEL=<서빙 모델명>
LLM_MAIN_BASE_URL=
LLM_MAIN_API_KEY=
LLM_MAIN_MODEL=

# 개발 중 같은 입력 재호출 방지 (data/cache). 프롬프트를 바꿨는데 결과가 안 바뀌면 캐시를 지울 것.
ENABLE_RESPONSE_CACHE=true

# ── SSO 소스(학사정보시스템) — eclass_agent 폴더 위치 ──
# 비워 두면 코드 기본값 = 이 폴더 옆의 eclass_agent (clone 한 그대로면 손댈 것 없음). 다른 곳에 있으면 절대경로 지정.
ECLASS_AGENT_DIR=

# Playwright 브라우저 위치. 비워 두면 eclass_agent/.venv/pw-browsers 를 자동으로 찾아 쓴다.
PLAYWRIGHT_BROWSERS_PATH=
