{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "univ-us-server",
	"main": "src/index.ts",
	// wrangler 4.86.0 에 들어 있는 런타임이 아는 날짜까지만 쓸 수 있다 (README "버전을 고정한 이유")
	"compatibility_date": "2026-04-20",
	"observability": {
		"enabled": true
	},
	// 주소: https://univ-us-server.aim-output.workers.dev (aim-output 은 Cloudflare 계정의 workers.dev 이름)
	"workers_dev": true,
	// 배포할 때마다 생기는 "버전별 미리보기 주소"는 끈다 — 옛 버전이 실제 DB 에 붙은 채 공개 주소로 남지 않게.
	"preview_urls": false,
	// wrangler 사용 통계를 Cloudflare 로 보내지 않는다
	"send_metrics": false,
	// 브라우저로 여는 페이지(public/). 주소가 public/ 의 파일과 맞으면 코드를 거치지 않고 바로 내주고(요청 한도에 안 잡힌다),
	// 맞는 파일이 없을 때만 src/index.ts 가 받는다 — 그래서 페이지와 API 가 한 주소를 같이 쓴다.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"vars": {
		// 설치파일 원본은 GitHub Releases — 서버는 고정 주소(/download)만 내준다
		"RELEASES_URL": "https://github.com/AIM-Output/26-WE-Meet-Project/releases/latest"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "univ-us",
			// `npx wrangler d1 create univ-us --location apac` 로 만든 실제 DB (2026-11-16). id 는 비밀이 아니라 커밋해도 된다.
			// 로컬 실행(npm run dev)·테스트는 이 DB 에 닿지 않고 PC 안의 사본(.wrangler/)을 쓴다 —
			// 여기에 "remote": true 를 넣으면 로컬에서도 실제 DB 를 건드리게 되므로 넣지 않는다.
			"database_id": "0d057fd0-05fc-4837-b629-6a9136e3df1f",
			"migrations_dir": "migrations"
		}
	]
}