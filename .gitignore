# ── 프로젝트 루트 공통 (하위 폴더의 .gitignore 와 함께 적용) ──

# 개인 PC 전용 (절대경로가 박힌 바로가기 등)
*.lnk

# Windows / Office 찌꺼기
Thumbs.db
desktop.ini
~$*

# Python
__pycache__/
*.pyc
.venv/

# Claude Code 개인 설정
.claude/settings.local.json

# 에이전트 스킬 (npx skills add 로 각자 설치, 심볼릭 링크에 절대경로가 박힘)
.agents/
.claude/skills/
skills-lock.json
